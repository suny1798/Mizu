{
  "manifest_version": 3,
  "name": "Mizu · 简洁新标签页",
  "short_name": "Mizu",
  "version": "0.2.16",
  "description": "一张壁纸、一个搜索框，和你的常用网站。简洁、可自定义的新标签页。",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "history",
    "favicon"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Mizu 起始页",
    "default_popup": "popup.html"
  }
}
